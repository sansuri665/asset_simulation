{
  "schema_version": "asset-simulation-oil-shipping-demand-contract-v4",
  "contract_id": "oil_shipping_demand_v4",
  "model_version": "asset-simulation-oil-shipping-demand-v0.4.0",
  "time_scale": "month",
  "identity_fields": ["seed", "turn_index", "year", "month", "label"],
  "market_inputs": {
    "macro_information_year": "latest_completed_annual_year",
    "macro_realized_growth_pct": "percent_yoy",
    "macro_real_oil_price_index": "index_2025_100",
    "macro_brent_oil_price_usd": "current_usd_per_barrel"
  },
  "physical_oil_fields": {
    "days": "calendar_days",
    "desired_demand_mbd": "million_barrels_per_day",
    "realized_demand_mbd": "million_barrels_per_day",
    "production_mbd": "million_barrels_per_day",
    "production_capacity_mbd": "million_barrels_per_day",
    "spare_capacity_mbd": "million_barrels_per_day",
    "long_run_demand_regime": "stable_seed_level_scenario_id",
    "structural_demand_drag_pct": "percentage_points_of_annual_growth",
    "demand_seasonal_amplitude_pct": "percent_of_trend_demand",
    "demand_seasonal_phase_shift_months": "months",
    "demand_seasonal_shape_weight": "second_harmonic_ratio",
    "target_inventory_days": "days_of_trend_demand",
    "opening_inventory_mmbbl": "million_barrels",
    "inventory_change_mmbbl": "million_barrels",
    "closing_inventory_mmbbl": "million_barrels",
    "inventory_days": "days_of_realized_demand",
    "unmet_demand_mmbbl": "million_barrels",
    "mass_balance_residual_mmbbl": "million_barrels"
  },
  "shipping_demand_fields": {
    "shipping_market_scope": "compliant_conventional_crude_tanker_market",
    "seaborne_share": "ratio_of_global_realized_demand_in_scope",
    "inventory_trade_adjustment_mbd": "million_barrels_per_day",
    "seaborne_cargo_mbd": "million_barrels_per_day",
    "cargo_million_tonnes": "million_metric_tonnes_per_turn",
    "average_haul_nm": "cargo_weighted_nautical_miles",
    "trade_dislocation_index": "ratio",
    "tonne_nautical_miles_billion": "billion_tonne_nautical_miles_per_turn",
    "annualized_tonne_nautical_miles_billion": "billion_tonne_nautical_miles_per_year",
    "route_count": "count",
    "explicit_route_count": "count"
  },
  "route_fields": {
    "route_id": "stable_route_family_id",
    "route_name": "display_name",
    "origin_id": "stable_origin_region_id",
    "destination_id": "stable_destination_region_id",
    "is_other_pool": "boolean",
    "market_share": "ratio",
    "cargo_mbd": "million_barrels_per_day",
    "cargo_million_tonnes": "million_metric_tonnes_per_turn",
    "baseline_haul_nm": "nautical_miles",
    "effective_haul_nm": "nautical_miles",
    "tonne_nautical_miles_billion": "billion_tonne_nautical_miles_per_turn",
    "annualized_tonne_nautical_miles_billion": "billion_tonne_nautical_miles_per_year",
    "route_status": "normal_rerouted_or_shortened",
    "chokepoints": "display_only_string_array"
  },
  "regional_flow_fields": {
    "region_id": "stable_region_id",
    "region_name": "display_name",
    "cargo_mbd": "million_barrels_per_day",
    "cargo_million_tonnes": "million_metric_tonnes_per_turn",
    "market_share": "ratio"
  },
  "invariants": [
    "one turn is one full calendar month",
    "closing_inventory = opening_inventory + production * days - realized_demand * days",
    "long-run demand regime is selected once per seed and remains stable",
    "inventory target moves gradually and never reads future information",
    "demand seasonality changes gradually by year and is not a fixed monthly template",
    "route network represents only compliant conventional crude tanker trade",
    "russian-origin, sanctioned-origin, shadow-fleet and opaque trade are outside the route network",
    "the other compliant route pool cannot contain an excluded market scope",
    "nine explicit route families plus one other compliant pool exhaust seaborne cargo",
    "sum(route cargo) = seaborne cargo",
    "sum(regional exports) = sum(regional imports) = seaborne cargo",
    "sum(route tonne-miles) = published tonne-miles",
    "published average haul is cargo-weighted across route families",
    "seaborne cargo is a flow and is not a freight rate",
    "no freight-rate path exists in this contract",
    "only the latest completed annual macro row is available to a turn",
    "player actions do not alter public oil or shipping demand"
  ],
  "scenario_fields": {
    "demand_rate_impulse_pct": "percent",
    "production_outage_mbd": "million_barrels_per_day",
    "seaborne_share_impulse_pp": "percentage_points",
    "average_haul_impulse_pct": "percent"
  }
}
