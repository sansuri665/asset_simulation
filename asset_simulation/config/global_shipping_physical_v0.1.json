    "baltic_speed_2015": {
      "kind": "historical_primary_benchmark",
      "as_of": "2015-05-01",
      "url": "https://www.balticexchange.com/en/data-services/WeeklyRoundup/tanker/news/2015/revised-tanker-benchmarkspecifications.html",
